<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Recipe — Recipes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-layout">
    <!-- Left Rail Navigation -->
    <aside class="sidebar">
      <a href="/recipes" class="sidebar-brand">
        <span class="brand-icon">&#9832;</span>
        Recipes
      </a>
      <nav>
        <ul class="sidebar-nav">
          <li><a href="/recipes">
            <span class="nav-icon">&#9776;</span> All Recipes
          </a></li>
          <li><a href="/recipes/new" class="active">
            <span class="nav-icon">+</span> New Recipe
          </a></li>
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <a href="/recipes" class="back-link">&larr; Back to recipes</a>

      <div class="page-header">
        <h1>New Recipe</h1>
      </div>

      <% if !errors.empty? %>
        <div class="flash-notice">
          Please fix the errors below before submitting.
        </div>
      <% end %>

      <div class="card" style="max-width:720px;">
        <form action="/recipes" method="post">
          <!-- Name -->
          <div class="form-group">
            <label for="name" class="form-label required">Recipe Name</label>
            <input type="text" id="name" name="name"
                   class="form-input <%= errors["name"]? ? "has-error" : "" %>"
                   value="<%= form["name"] %>"
                   placeholder="e.g. Classic Margherita Pizza"
                   autofocus required>
            <% if msg = errors["name"]? %>
              <div class="form-error"><%= msg %></div>
            <% end %>
          </div>

          <!-- Description -->
          <div class="form-group">
            <label for="description" class="form-label">Description</label>
            <input type="text" id="description" name="description"
                   class="form-input"
                   value="<%= form["description"] %>"
                   placeholder="A short summary of this recipe">
          </div>

          <!-- Category & Difficulty row -->
          <div class="form-row">
            <div class="form-group">
              <label for="category" class="form-label">Category</label>
              <select id="category" name="category" class="form-select">
                <% ["Uncategorized","Italian","Mexican","Asian","Desserts","American","Mediterranean","Indian","Breakfast","Soups"].each do |cat| %>
                  <option value="<%= cat %>" <%= form["category"] == cat ? "selected" : "" %>><%= cat %></option>
                <% end %>
              </select>
            </div>
            <div class="form-group">
              <label for="difficulty" class="form-label">Difficulty</label>
              <select id="difficulty" name="difficulty" class="form-select">
                <% {"easy" => "Easy", "medium" => "Medium", "hard" => "Hard"}.each do |val, label| %>
                  <option value="<%= val %>" <%= form["difficulty"] == val ? "selected" : "" %>><%= label %></option>
                <% end %>
              </select>
              <% if msg = errors["difficulty"]? %>
                <div class="form-error"><%= msg %></div>
              <% end %>
            </div>
          </div>

          <!-- Servings & Times row -->
          <div class="form-row">
            <div class="form-group">
              <label for="servings" class="form-label">Servings</label>
              <input type="number" id="servings" name="servings"
                     class="form-input"
                     value="<%= form["servings"] %>"
                     placeholder="4" min="1">
            </div>
            <div class="form-group">
              <label for="prep_minutes" class="form-label">Prep (minutes)</label>
              <input type="number" id="prep_minutes" name="prep_minutes"
                     class="form-input"
                     value="<%= form["prep_minutes"] %>"
                     placeholder="15" min="0">
            </div>
            <div class="form-group">
              <label for="cook_minutes" class="form-label">Cook (minutes)</label>
              <input type="number" id="cook_minutes" name="cook_minutes"
                     class="form-input"
                     value="<%= form["cook_minutes"] %>"
                     placeholder="30" min="0">
            </div>
          </div>

          <!-- Ingredients -->
          <div class="form-group">
            <label for="ingredients" class="form-label required">Ingredients</label>
            <textarea id="ingredients" name="ingredients"
                      class="form-textarea <%= errors["ingredients"]? ? "has-error" : "" %>"
                      rows="8"
                      placeholder="Enter each ingredient on a new line, e.g.:&#10;2 cups flour&#10;1 tsp salt&#10;3 eggs"
                      required><%= form["ingredients"] %></textarea>
            <div class="form-hint">One ingredient per line. Include quantities and units.</div>
            <% if msg = errors["ingredients"]? %>
              <div class="form-error"><%= msg %></div>
            <% end %>
          </div>

          <!-- Instructions -->
          <div class="form-group">
            <label for="instructions" class="form-label required">Instructions</label>
            <textarea id="instructions" name="instructions"
                      class="form-textarea <%= errors["instructions"]? ? "has-error" : "" %>"
                      rows="10"
                      placeholder="Enter each step on a new line, e.g.:&#10;Preheat oven to 375°F.&#10;Mix dry ingredients.&#10;Bake for 25 minutes."
                      required><%= form["instructions"] %></textarea>
            <div class="form-hint">One step per line. Steps will be numbered automatically on the detail page.</div>
            <% if msg = errors["instructions"]? %>
              <div class="form-error"><%= msg %></div>
            <% end %>
          </div>

          <!-- Actions -->
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save Recipe</button>
            <a href="/recipes" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </main>
  </div>
</body>
</html>
