<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= recipe.name %> — Recipes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="app-layout">
    <!-- Left Rail Navigation -->
    <aside class="sidebar">
      <a href="/recipes" class="sidebar-brand">
        <span class="brand-icon">&#9832;</span>
        Recipes
      </a>
      <nav>
        <ul class="sidebar-nav">
          <li><a href="/recipes">
            <span class="nav-icon">&#9776;</span> All Recipes
          </a></li>
          <li><a href="/recipes/new">
            <span class="nav-icon">+</span> New Recipe
          </a></li>
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
      <a href="/recipes" class="back-link">&larr; Back to recipes</a>

      <div class="recipe-detail">
        <div class="page-header">
          <h1><%= recipe.name %></h1>
        </div>

        <!-- Meta badges row -->
        <div class="recipe-meta-row">
          <span class="badge badge-category"><%= recipe.category %></span>
          <span class="badge badge-difficulty <%= recipe.difficulty %>"><%= recipe.difficulty %></span>
          <% if s = recipe.servings %>
            <span class="badge-time">&#127860; <%= s %> serving<%= s == 1 ? "" : "s" %></span>
          <% end %>
          <% if m = recipe.prep_minutes %>
            <span class="badge-time">&#9202; <%= m %>m prep</span>
          <% end %>
          <% if m = recipe.cook_minutes %>
            <span class="badge-time">&#128293; <%= m %>m cook</span>
          <% end %>
          <% if recipe.prep_minutes && recipe.cook_minutes %>
            <span class="badge-time">&#9200; <%= recipe.prep_minutes.not_nil! + recipe.cook_minutes.not_nil! %>m total</span>
          <% end %>
        </div>

        <!-- Description -->
        <% if desc = recipe.description %>
          <p style="color:var(--text-secondary);font-size:1rem;line-height:1.6;margin-bottom:1.5rem;"><%= desc %></p>
        <% end %>

        <div class="card" style="padding:1.5rem;">
          <!-- Ingredients -->
          <div class="recipe-section">
            <h2>Ingredients</h2>
            <ul class="ingredient-list">
              <% recipe.ingredients.split('\n').each do |line| %>
                <% next if line.strip.empty? %>
                <li><%= line.strip %></li>
              <% end %>
            </ul>
          </div>

          <!-- Instructions -->
          <div class="recipe-section">
            <h2>Instructions</h2>
            <ol class="instruction-list">
              <% recipe.instructions.split('\n').each do |line| %>
                <% next if line.strip.empty? %>
                <li><%= line.strip %></li>
              <% end %>
            </ol>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
